# Mailrelay (mail-server/send-mail.php) en fotouploader (upload-server/upload-kunstwerk-foto.php).
# Bewust ZONDER `NEXT_PUBLIC_`-prefix: die waarden bakt Next.js letterlijk in de
# client-bundle, waarmee het gedeelde secret voor iedere bezoeker leesbaar was en
# de relay als open mail relay te gebruiken viel. De browser praat nu met
# /api/mail en /api/upload; alleen de server kent deze waarden.
MAIL_ENDPOINT_URL=https://glassartanddesign.com/mail-server/send-mail.php
MAIL_SECRET=changeme
UPLOAD_ENDPOINT_URL=https://glassartanddesign.com/upload-server/upload-kunstwerk-foto.php
UPLOAD_SECRET=changeme
